GEMINI_API_KEY=your_gemini_api_key
# Optional
GEMINI_MODEL=gemini-3.5-flash
# Comma-separated models to try if the primary is overloaded or out of quota.
# Must be Mozaik-supported ids: gemini-3.5-flash, gemini-3.1-pro-preview,
# claude-haiku-4-5, claude-sonnet-4-6, gpt-5.4-mini, ... Other providers need
# their key, e.g. FALLBACK_MODELS=claude-haiku-4-5 plus ANTHROPIC_API_KEY.
FALLBACK_MODELS=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
RUN_TIMEOUT_MS=600000
# Free-tier Gemini Flash allows 5 requests/minute; raise on paid keys
REQUESTS_PER_MINUTE=5
APPROVAL_LIMIT_EUR=5000
